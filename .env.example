# Copy this file to ".env" and fill in your real keys.
# Never upload ".env" to git (it is already listed in .gitignore).
# Only add the keys you actually use.

# Anthropic (Claude models)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI (GPT models)
OPENAI_API_KEY=your-openai-key-here

# LangSmith (optional: tracing and debugging your graphs)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=langgraph-course
